{
    "name": "riesenia/persist-related-data",
    "description": "CakePHP ORM plugin for persisting selected fields of related tables",
    "keywords": ["cakephp", "orm", "related", "materialize"],
    "type": "cakephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Tomas Saghy",
            "email": "segy@riesenia.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "cakephp/orm": "^4.0"
    },
    "require-dev": {
        "cakephp/cakephp": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^8.5|^9.3",
        "rshop/php-cs-fixer-config": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "PersistRelatedData\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PersistRelatedData\\Test\\": "tests",
            "Cake\\Test\\": "./vendor/cakephp/cakephp/tests"
        }
    }
}
